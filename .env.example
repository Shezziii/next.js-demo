# Public site URL (used for SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API (server-side only)
API_BASE_URL=http://localhost:4000/api/v1
API_TIMEOUT_MS=10000

# Use fake data until the backend is ready
USE_MOCK_API=true

# Signs the session cookie (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-random-32-plus-character-string
